#!/usr/bin/env bash
# SessionStart hook for the skillet plugin.
# Injects the using-skillet bootstrap so skills auto-trigger at the right moments.
#
# Hardening notes:
# - Works with an empty or broken PATH: only bash builtins are used (no dirname,
#   no cat on the required path). A SessionStart hook can be spawned before any
#   PATH-repairing hook has run.
# - Fails closed: if the skill file cannot be read, emit nothing on stdout and
#   exit non-zero without a message, so an error string is never injected into
#   the session as if it were skill content.

set -euo pipefail

# Derive the script directory from $0 by splitting on the last / or \ (the
# Windows wrapper passes a backslash path). No separator means the current
# directory.
case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" 2>/dev/null && pwd)" || exit 1 ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." 2>/dev/null && pwd)" || exit 1

skill_md="${PLUGIN_ROOT}/skills/using-skillet/SKILL.md"
if [ ! -r "$skill_md" ]; then
  exit 1
fi
# $(<file) is a bash builtin read, so it needs no cat on PATH.
using_skillet_content="$(<"$skill_md")" || exit 1
if [ -z "$using_skillet_content" ]; then
  exit 1
fi

# Escape for JSON embedding (single C-level passes, fast).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_skillet_escaped=$(escape_for_json "$using_skillet_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have skillet.\n\n**Below is the full content of your 'skillet:using-skillet' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_skillet_escaped}\n</EXTREMELY_IMPORTANT>"

# printf (not heredoc) avoids the bash 5.3+ heredoc hang. When cat exists the
# output goes through it, which absorbs EPIPE if the harness closes stdout
# early (Git Bash on Windows reports that as a printf write error). When PATH
# is broken and cat is missing, printf alone still delivers the context.
emit_json() {
  # shellcheck disable=SC2059 # every caller passes a literal format string
  if command -v cat >/dev/null 2>&1; then
    printf "$@" | cat
  else
    printf "$@"
  fi
}

# Emit only the field the current platform consumes.
# Cursor: additional_context. Claude Code: hookSpecificOutput.additionalContext.
# Copilot CLI / SDK standard: top-level additionalContext.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  emit_json '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
